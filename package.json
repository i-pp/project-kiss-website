{
  "name": "project-kiss-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "python3 -B -m unittest discover -s tests -p 'test_*.py'",
    "test:links": "python3 -B scripts/check_site.py",
    "test:external": "python3 -B scripts/check_site.py --external",
    "verify": "npm run check && npm run build && npm test && npm run test:links"
  },
  "dependencies": {
    "astro": "7.4.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@playwright/cli": "0.1.23",
    "axe-core": "4.14.0",
    "typescript": "5.9.3"
  }
}
